# Arcade project API key. Read on the server only; never NEXT_PUBLIC_, never committed.
ARCADE_API_KEY=
# Arcade user id whose Gmail (and optionally Calendar) is authorized. The demo account, not a personal one.
ARCADE_USER_ID=
# Gmail search query for the vault message. Optional; this default matches recent gift or trip mail.
ARCADE_CONTEXT_QUERY=newer_than:120d (jacket OR scotland OR gift OR trip OR waterproof)
